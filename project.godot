; Engine configuration file.
; Infinite Frontier - Godot 4.7

config_version=5

[application]

config/name="Infinite Frontier"
config/description="A deterministic, offline, procedurally generated survival exploration RPG."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.027, 0.047, 0.071, 1)
config/icon="res://assets/branding/icon.svg"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
LogManager="*res://scripts/core/log_manager.gd"
SettingsManager="*res://scripts/core/settings_manager.gd"
GameManager="*res://scripts/core/game_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.027, 0.047, 0.071, 1)

[input]

move_up={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
run={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
roll={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
pause={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
regenerate_world={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
toggle_noise_view={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":78)]
}

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Interactable"
2d_physics/layer_4="Enemy"
